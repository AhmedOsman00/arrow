#!/bin/bash

set -e

echo "🔧 Running swift-format and SwiftLint on staged files..."

# Get list of staged Swift files
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep ".swift$" || true)

if [ -z "$STAGED_SWIFT_FILES" ]; then
    echo "✅ No Swift files to lint."
    exit 0
fi

# Run swift-format on staged files
echo "🎨 Running swift-format..."
echo "$STAGED_SWIFT_FILES" | xargs swift format --in-place

# Re-add formatted files
echo "$STAGED_SWIFT_FILES" | xargs git add

# Run the pinned SwiftLint on staged files - this will fail on issues
echo "🧹 Running SwiftLint..."
if ! echo "$STAGED_SWIFT_FILES" | xargs ./scripts/swiftlint.sh --quiet; then
    echo "❌ SwiftLint found issues. Please fix them before committing."
    exit 1
fi

echo "✅ Formatting and linting complete."

exit 0